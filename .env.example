# copy to .env and fill in. Never commit the real .env.

# --- Model provider (OpenAI-compatible endpoint) ---------------------------
TSQL_BASE_URL=
TSQL_MODEL=
TSQL_API_KEY=
TSQL_API_MODE=chat_completions
# Optional: override the auto-detected context window
# TSQL_CONTEXT_LENGTH=

# --- Database --------------------------------------------------------------
TSQL_DB_DIALECT=sqlite
TSQL_DB_PATH=
# TSQL_DB_URL=postgres://user:pass@host:5432/dbname

# --- State -----------------------------------------------------------------
TSQL_STATE_DB=~/.text_sql/state.db

# --- Governance ------------------------------------------------------------
# Comma-separated allowlist. Empty means "discover at runtime".
# TSQL_ALLOWED_TABLES=
# smart | manual | off
TSQL_APPROVAL_MODE=smart
